# Copy this file to deploy/.env and fill in real values.
# deploy/.env is ignored by Git and must never be committed.
ALI_BAI_LIAN_API_KEY=your-dashscope-api-key
TAVILY_API_KEY=your-tavily-api-key

MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
ES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me

SUPER_AGENT_ADMIN_USERNAME=admin
SUPER_AGENT_ADMIN_PASSWORD=change-me
SUPER_AGENT_ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/super_agent_business_chat?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

MYSQL_PORT=13306
BACKEND_UPSTREAM=host.docker.internal:9082
FRONTEND_PORT=8088

DOCLING_PORT=5001
DOCLING_BASE_IMAGE=quay.nju.edu.cn/docling-project/docling-serve:v1.38.1
HF_ENDPOINT=https://hf-mirror.com
DOCUMENT_STRUCTURE_PROVIDER=docling
DOCLING_DO_OCR=false
DOCLING_OCR_ENGINE=easyocr
DOCLING_TABLE_MODE=accurate
