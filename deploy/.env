# ===== 容器内后端的数据源 =====
# 默认用编排自带的 MySQL；若要和本机原生 MySQL（方式 B 用的那个库）共用同一份数据，
# 改成：jdbc:mysql://host.docker.internal:3306/super_agent_business_chat?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/super_agent_business_chat?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

# ===== 宿主机映射端口 =====
MYSQL_PORT=13306

# ===== 前端反代的后端上游 =====
# host.docker.internal:9082 -> 宿主机 9082（IDE 里跑后端时用这个）
# backend:9082              -> 容器网络里的后端容器
BACKEND_UPSTREAM=host.docker.internal:9082

# ===== 前端对外端口 =====
FRONTEND_PORT=8088

# ===== Docling 文档结构解析 =====
DOCLING_PORT=5001
DOCLING_BASE_IMAGE=quay.nju.edu.cn/docling-project/docling-serve:v1.38.1
HF_ENDPOINT=https://hf-mirror.com
DOCUMENT_STRUCTURE_PROVIDER=docling
DOCLING_DO_OCR=false
DOCLING_OCR_ENGINE=easyocr
DOCLING_TABLE_MODE=accurate
